<%- include("partials/header.ejs") %>


<div class="page-heading">
    <h1>Edit Post</h1>
    <h2>Change Something About It...</h2>

    <% if (error !== null) { %>
        <h3 class="form-error">Error: <%= error %></h3>
    <% } %>

</div>

<!-- EDIT BLOG POST FORM CARD -->
<div class="white-card form-card">
            
    <form action="/posts/<%= post.id %>/edit" method="POST">

        <label>Blog Post Title</label>
    
        <input class="form-input"
            type="text"
            name="title"
            value="<%= title %>"
        >





    
        <label class="margin-top-large">Blog Post Content</label>
    
        <textarea class="form-input form-textarea" name="content"><%= content %></textarea>
    

    <button  class="button rounded-button margin-top-medium" type="submit">Save Changes</button>

</form>

</div>









<%- include("partials/footer.ejs") %>