<%- include("partials/header.ejs") %>


<!-- TITLE SECTION -->
<div class="page-heading">
    <h1>Join CoveBlog</h1>
    <h2>Create an account and start sharing your stories.</h2>

    <% if (error !== null) { %>
        <h3 class="form-error">Error: <%= error %></h3>
    <% } %>





</div>

<!-- REGISTER FORM CARD -->
<div class="white-card form-card">
            
    <form action="/register" method="POST">

        <label>Username</label>
    
        <input class="form-input"
            type="text"
            name="title"
            placeholder="Choose a username"
        >


        <label class="margin-top-small">Email address</label>
    
        <input class="form-input"
            type="text"
            name="title"
            placeholder="you@example.com"
        >


        <label class="margin-top-small">Password</label>
    
        <input class="form-input"
            type="text"
            name="title"
            placeholder="Create a password"
        >


        <label class="margin-top-small">Confirm password</label>
    
        <input class="form-input"
            type="text"
            name="title"
            placeholder="Retype your password"
        >
    

        <button class="button full-width-button" type="submit">Create Account</button>


    </form>

    <div class="divider auth-divider" >
        <span></span>
        <p>OR</p>
        <span></span>
    </div>

    <button class="button full-width-button no-top-margin" type="button">
        <span class="google-logo">G</span>
        <p>Continue with Google</p>
    </button>

    <p class="login-prompt">
        Already have an account?
        <a href="/login">Log in</a>
    </p>





</div>

























<%- include("partials/footer.ejs") %>