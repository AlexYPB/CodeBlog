<%- include("partials/header.ejs") %>



<!-- TITLE SECTION -->
<div class="page-heading">
    <h1>Create a New Post</h1>
    <h2>Share Something New...</h2>

    <% if (error !== null) { %>
        <h3 class="form-error">Error: <%= error %></h3>
    <% } %>





</div>

<!-- CREATE BLOG POST FORM CARD -->
<div class="white-card form-card">
            
    <form action="/create" method="POST">
        <label>Blog Post Title</label>
    
        <input value="<%= title %>" class="form-input"
            type="text"
            name="title"
            placeholder="Write your title here..."
        >



    
        <label class="margin-top-large">Blog Post Content</label>
    
        <textarea class="form-input form-textarea"
            type="text"
            name="content"
            placeholder="Write your post here..."
        ><%= content %></textarea>
    

    <button  class="button rounded-button margin-top-medium" type="submit">Publish</button>

</form>

</div>







<%- include("partials/footer.ejs") %>