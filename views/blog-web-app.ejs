<%- include("partials/header.ejs") %>



    <!-- SIMPLE WELCOME SECTION -->
    <div class="page-heading">
        <h1>Welcome to CoveBlog</h1>
        <h2>This is where you document your journey...</h2>
    </div>












    <!-- RECENT POSTS SECTION -->
     <div class="recent-posts-section">
        <h2>Blog Posts</h2>

        <!-- NO POSTS ALERT MESSAGE -->
        <% if (posts.length == 0) { %>
                <h2 class="empty-message empty-message-with-spacing">No posts yet.</h2>
                <a href="/create" class="button rounded-button">Create Your First Post!</a>
        <% } %>

         <!-- SHOWS ALL POSTS -->
        <% for (let i = 0; i < posts.length; i++) { %>
            <div class="white-card">
                <h2><%= posts[i].title %></h2>
                <p class="post-date">
                    <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >

                        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>

                    <%= posts[i].created_at.toLocaleDateString("en-US", {month: "long", day: "numeric", year: "numeric"}) %>
                </p>

                <p>
                    <% if (posts[i].content.length > 150) { %>
                        <%= posts[i].content.slice(0,150) + "..." %>
                    <% } else { %>
                        <%= posts[i].content %>
                    <% } %>
                </p>

                <a class="button" href="/posts/<%=posts[i].id %>">Read More</a>
            </div>
        <% } %>

















     </div>




     <%- include("partials/footer.ejs") %>